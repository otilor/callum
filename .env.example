# Copy this file to .env. Every line is optional except CALLUM_PASSWORD when Callum runs on a server.

# Port the server listens on (default 4600).
PORT=4600

# Folder for the database and the saved LinkedIn session (default ./data).
CALLUM_DATA_DIR=./data

# Required when Callum is reachable from other computers. With it set, Callum listens on every interface and asks for it at sign-in.
CALLUM_PASSWORD=

# Set to 1 when Callum is behind one HTTPS reverse proxy that sets X-Forwarded-For. Password mode on a network needs that proxy; see the README.
# CALLUM_TRUST_PROXY=1

# Claude writes, reads replies and finds people. On your own computer Callum uses the Claude Code you are signed in to,
# so no key is needed. On a server, set a Claude API key here (see docs/SETUP.md#claude). Without either, Callum uses
# plain templates and the lists you bring.
ANTHROPIC_API_KEY=
# CALLUM_MODEL=claude-opus-5-5
# CALLUM_CLAUDE_PATH=/path/to/claude
# CALLUM_CLAUDE_CODE=off

# Client ID from your Microsoft app registration (see docs/SETUP.md#microsoft).
CALLUM_MICROSOFT_CLIENT_ID=

# Time zone to start with, for example Africa/Lagos. Defaults to this computer's.
TZ_DEFAULT=

# Try Callum with made-up people and no real sending.
# CALLUM_DEMO=1
# CALLUM_DEMO_SCENE=morning
