{
  "name": "callum",
  "version": "0.1.0",
  "private": true,
  "description": "Callum: calm outreach that keeps going while you do other things.",
  "author": "Gabriel",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test -c playwright.desktop.config.ts",
    "dev:web": "vite",
    "test:mail": "bash scripts/mail-it.sh",
    "test:real": "node --disable-warning=ExperimentalWarning --import tsx scripts/real-run.mts",
    "screenshots": "node --disable-warning=ExperimentalWarning --import tsx scripts/screenshots.mts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/server/main.ts",
    "dev:server": "CALLUM_DEMO=1 node --disable-warning=ExperimentalWarning --watch --import tsx src/server/main.ts",
    "demo": "CALLUM_DEMO=1 npm start",
    "desktop:compile": "tsc -p tsconfig.server.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && node scripts/preload-package.mjs",
    "desktop:prepare": "npm run build && npm run desktop:compile",
    "desktop:dev": "npm run desktop:prepare && electron .",
    "desktop:build": "npm run desktop:prepare && electron-builder --dir",
    "desktop:dist": "npm run desktop:prepare && electron-builder",
    "start:dist": "node --disable-warning=ExperimentalWarning dist/server/main.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/onest": "5.3.1",
    "@hono/node-server": "2.1.6",
    "csv-parse": "^7.0.3",
    "hono": "4.13.16",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "nodemailer": "^10.3.1",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  }
}
